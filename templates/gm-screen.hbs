<div class="pf2e-gs-root">

  <!-- Top Utility Bar: Live Search, Focus Level Sync, Customize Show/Hide -->
  <header class="pf2e-gs-topbar">
    <div class="pf2e-gs-search-wrap">
      <i class="fa-solid fa-magnifying-glass pf2e-gs-search-icon"></i>
      <input type="text" class="pf2e-gs-search" value="{{searchQuery}}"
        placeholder="Filter all tables & rules (e.g. stealth, fly, poison, ritual, chase, influence, hexploration)..."
        autocomplete="off" />
      <button type="button" class="pf2e-gs-search-clear" title="Clear filter"
        style="{{#unless searchQuery}}display:none;{{/unless}}">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </div>

    <div class="pf2e-gs-level-bar"
      title="Highlight rows and calculate DCs for this level (click Party to snap back to Party Level {{partyLevel}})">
      <span class="pf2e-gs-level-label">Focus Lv</span>
      <button type="button" class="pf2e-gs-btn pf2e-gs-btn-icon" data-gs-action="level-step" data-delta="-1"
        title="Decrease Focus Level">
        <i class="fa-solid fa-minus"></i>
      </button>
      <span class="pf2e-gs-level-val">Lv {{focusLevel}}</span>
      <button type="button" class="pf2e-gs-btn pf2e-gs-btn-icon" data-gs-action="level-step" data-delta="1"
        title="Increase Focus Level">
        <i class="fa-solid fa-plus"></i>
      </button>
      {{#unless isAtPartyLevel}}
      <button type="button" class="pf2e-gs-btn pf2e-gs-btn-xs" data-gs-action="reset-party-level"
        title="Reset to Party Level {{partyLevel}}">
        Party ({{partyLevel}})
      </button>
      {{/unless}}
    </div>

    <button type="button"
      class="pf2e-gs-btn {{#if customizeOpen}}is-active{{/if}} {{#if hasHiddenCards}}pf2e-gs-btn-accent{{/if}}"
      data-gs-action="toggle-customize"
      title="Check or uncheck GM Screen sections to customize your layout (saves automatically)">
      <i class="fa-solid fa-sliders"></i>
      <span class="pf2e-gs-cust-btn-label">Customize{{#if hiddenCardCount}} ({{hiddenCardCount}} hidden){{/if}}</span>
    </button>
  </header>

  <!-- Category Tab Strip -->
  <nav class="pf2e-gs-tabs">
    {{#each tabs}}
    <button type="button"
      class="pf2e-gs-tab {{#if this.isActive}}is-active{{/if}} {{#if this.allHidden}}is-all-hidden{{/if}}"
      data-gs-action="select-tab" data-tab="{{this.id}}">
      <i class="{{this.icon}}"></i>
      <span>{{this.label}}</span>
    </button>
    {{/each}}
    <span class="pf2e-gs-search-banner" style="display:none;"></span>
  </nav>

  <!-- Inline Collapsible Customize Drawer (Saves Per GM Client) -->
  <div class="pf2e-gs-customize-drawer {{#if customizeOpen}}is-open{{/if}}">
    <div class="pf2e-gs-customize-head">
      <div class="pf2e-gs-customize-title">
        <i class="fa-solid fa-sliders"></i>
        <strong>Customize Visible Sections</strong>
        <span class="pf2e-gs-subhint">Changes save automatically · Live Search still finds hidden sections when you need
          them mid-session</span>
      </div>
      <div class="pf2e-gs-customize-actions">
        <button type="button" class="pf2e-gs-btn pf2e-gs-btn-xs" data-gs-action="show-all-cards"
          style="{{#unless hasHiddenCards}}display:none;{{/unless}}">
          <i class="fa-solid fa-eye"></i> Show All
        </button>
        <button type="button" class="pf2e-gs-btn pf2e-gs-btn-gold pf2e-gs-btn-xs" data-gs-action="toggle-customize">
          <i class="fa-solid fa-check"></i> Done
        </button>
      </div>
    </div>

    <div class="pf2e-gs-customize-scroll">
      <div class="pf2e-gs-customize-grid">
        {{#each customizeGroups}}
        <div class="pf2e-gs-cust-group">
          <div class="pf2e-gs-cust-group-head">
            <span><i class="{{this.icon}}"></i> {{this.label}}</span>
            <button type="button" class="pf2e-gs-cust-link" data-gs-action="toggle-tab-cards" data-tab="{{this.tabId}}">
              {{#if this.allVisible}}Hide All{{else}}Show All{{/if}}
            </button>
          </div>
          <div class="pf2e-gs-cust-items">
            {{#each this.cards}}
            <label class="pf2e-gs-cust-item">
              <input type="checkbox" class="pf2e-gs-cust-cb" data-card-id="{{this.id}}" {{#if
                this.visible}}checked{{/if}} />
              <span>{{this.label}}</span>
            </label>
            {{/each}}
          </div>
        </div>
        {{/each}}
      </div>
    </div>
  </div>

  <!-- Scrollable Reference Body -->
  <div class="pf2e-gs-body">

    <!-- =================================================================== -->
    <!-- TAB 1: DCs, ADJUSTMENTS, DEGREES, HERO POINTS & COUNTERACT          -->
    <!-- =================================================================== -->
    <section class="pf2e-gs-stack" data-gs-panel="dcs">

      <!-- Quick DC Live Bar (Full-Width) -->
      <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'dc-calculator')}}is-user-hidden{{/if}}"
        data-gs-card="dc-calculator"
        data-gs-keywords="dc calculator simple level adjustment difficulty check prompt chat">
        <div class="pf2e-gs-card-head">
          <h4><i class="fa-solid fa-bullseye"></i> Quick DC Calculator &amp; Simple DCs</h4>
          <div class="pf2e-gs-card-head-right">
            <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            <span class="pf2e-gs-subhint">Click any Adjustment chip, Simple DC, or Level row to update live</span>
          </div>
        </div>

        <div class="pf2e-gs-card-body">
          <div class="pf2e-gs-dc-hero">
            <div class="pf2e-gs-dc-readout">
              <span class="pf2e-gs-dc-big">DC {{finalDc}}</span>
              <div class="pf2e-gs-dc-meta">
                <span>
                  {{#if simpleDcOverride}}
                  <strong>{{simpleDcOverride.rank}} Simple DC</strong> (Base {{baseDc}})
                  {{else}}
                  <strong>Level {{focusLevel}} DC</strong> (Base {{baseDc}}) · Spell Rank {{spellRank}} DC:
                  <strong>{{spellRankDc}}</strong>
                  {{/if}}
                </span>
                <span>Adjustment: <strong>{{dcAdjustmentLabel}} ({{dcAdjustmentSigned}})</strong></span>
              </div>
            </div>

            <div class="pf2e-gs-check-sender">
              <select class="pf2e-gs-select pf2e-gs-check-skill" title="Check type to post to Chat">
                {{#each quickCheckSkills}}
                <option value="{{this.slug}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
                {{/each}}
              </select>
              <label class="pf2e-gs-subhint" style="display:inline-flex;align-items:center;gap:4px;cursor:pointer;">
                <input type="checkbox" class="pf2e-gs-check-secret" {{#if secretCheck}}checked{{/if}} />
                Secret
              </label>
              <button type="button" class="pf2e-gs-btn pf2e-gs-btn-gold" data-gs-action="send-check-chat"
                title="Post a clickable PF2e @Check prompt for DC {{finalDc}} to Foundry Chat">
                <i class="fa-solid fa-dice-d20"></i> Chat @Check
              </button>
            </div>
          </div>

          <div class="pf2e-gs-adj-chips">
            {{#each dcAdjustments}}
            <button type="button" class="pf2e-gs-chip {{#if this.isActive}}is-active{{/if}}" data-gs-action="set-dc-adj"
              data-delta="{{this.delta}}"
              title="{{this.label}}{{#if this.rarity}} ({{this.rarity}} Recall Knowledge){{/if}}">
              {{this.shortLabel}} ({{this.deltaSigned}}){{#if this.rarity}} · {{this.rarity}}{{/if}}
            </button>
            {{/each}}
          </div>

          <div class="pf2e-gs-simple-strip">
            {{#each simpleDcs}}
            <div class="pf2e-gs-simple-box {{#if this.isActive}}is-active{{/if}}" data-gs-action="set-simple-dc"
              data-rank="{{this.rank}}" data-dc="{{this.dc}}"
              title="Click to toggle {{this.rank}} Simple DC ({{this.dc}})">
              <div class="pf2e-gs-simple-rank">{{this.rank}}</div>
              <div class="pf2e-gs-simple-dc">{{this.dc}}</div>
            </div>
            {{/each}}
          </div>
        </div>
      </div>

      <!-- Balanced 2-Column Masonry for DCs, Degrees, Hero Points, Counteract & Flat Checks -->
      <div class="pf2e-gs-masonry">

        <!-- DC by Level (Compact 2-Column Split for Lv 0–25) -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'dc-by-level')}}is-user-hidden{{/if}}"
          data-gs-card="dc-by-level" data-gs-keywords="dc by level table standard level-based difficulty 0 25">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-table-list"></i> DC by Level (0–25)</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
              <span class="pf2e-gs-subhint">Click any level to focus</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <table class="pf2e-gs-table">
              <thead>
                <tr>
                  <th class="is-num">Lv</th>
                  <th class="is-num">DC</th>
                  <th class="is-num pf2e-gs-split-col">Lv</th>
                  <th class="is-num">DC</th>
                </tr>
              </thead>
              <tbody>
                {{#each dcByLevelPaired}}
                <tr data-gs-row="1">
                  <td class="is-num is-clickable-lvl {{#if this.left.isActive}}is-dc is-cell-active{{/if}}"
                    data-gs-action="set-level" data-level="{{this.left.level}}">
                    Lv {{this.left.level}}
                  </td>
                  <td class="is-num is-dc is-clickable-lvl {{#if this.left.isActive}}is-cell-active{{/if}}"
                    data-gs-action="set-level" data-level="{{this.left.level}}">
                    {{this.left.dc}}
                  </td>
                  <td
                    class="is-num is-clickable-lvl pf2e-gs-split-col {{#if this.right.isActive}}is-dc is-cell-active{{/if}}"
                    data-gs-action="set-level" data-level="{{this.right.level}}">
                    Lv {{this.right.level}}
                  </td>
                  <td class="is-num is-dc is-clickable-lvl {{#if this.right.isActive}}is-cell-active{{/if}}"
                    data-gs-action="set-level" data-level="{{this.right.level}}">
                    {{this.right.dc}}
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Degrees of Success (Cleanly Separate from Hero Points) -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'degrees-of-success')}}is-user-hidden{{/if}}"
          data-gs-card="degrees-of-success" data-gs-keywords="degrees of success critical failure nat 20 nat 1 tie">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-scale-balanced"></i> Degrees of Success</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <table class="pf2e-gs-table">
              <tbody>
                {{#each degreesOfSuccess}}
                <tr data-gs-row="1">
                  <td><span class="pf2e-gs-pill {{this.cls}}">{{this.degree}}</span></td>
                  <td>{{this.rule}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Counteract Calculator & Rules -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'counteract')}}is-user-hidden{{/if}}"
          data-gs-card="counteract" data-gs-keywords="counteract dispel magic cleanse affliction rank check">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-wand-sparkles"></i> Counteract Calculator &amp; Rules</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
              <span class="pf2e-gs-subhint">Non-spell Rank = ⌈Level / 2⌉</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <div class="pf2e-gs-counteract-controls">
              <div class="pf2e-gs-stepper-group">
                <span>Your Rank</span>
                <button type="button" class="pf2e-gs-btn pf2e-gs-btn-icon" data-gs-action="counteract-step"
                  data-which="your" data-delta="-1"><i class="fa-solid fa-minus"></i></button>
                <span class="pf2e-gs-stepper-val">{{counteract.yourRank}}</span>
                <button type="button" class="pf2e-gs-btn pf2e-gs-btn-icon" data-gs-action="counteract-step"
                  data-which="your" data-delta="1"><i class="fa-solid fa-plus"></i></button>
              </div>
              <div class="pf2e-gs-stepper-group">
                <span>Target Rank</span>
                <button type="button" class="pf2e-gs-btn pf2e-gs-btn-icon" data-gs-action="counteract-step"
                  data-which="target" data-delta="-1"><i class="fa-solid fa-minus"></i></button>
                <span class="pf2e-gs-stepper-val">{{counteract.targetRank}}</span>
                <button type="button" class="pf2e-gs-btn pf2e-gs-btn-icon" data-gs-action="counteract-step"
                  data-which="target" data-delta="1"><i class="fa-solid fa-plus"></i></button>
              </div>
            </div>

            <div class="pf2e-gs-verdict {{counteract.verdictClass}}">
              Rank {{counteract.yourRank}} vs Rank {{counteract.targetRank}}: {{counteract.minDegreeNeeded}}
            </div>

            <table class="pf2e-gs-table">
              <thead>
                <tr>
                  <th>Degree</th>
                  <th>Counteracts Target If...</th>
                  <th class="is-num">Result</th>
                </tr>
              </thead>
              <tbody>
                {{#each counteract.outcomes}}
                <tr data-gs-row="1">
                  <td><span class="pf2e-gs-pill {{this.cls}}">{{this.degree}}</span></td>
                  <td>{{this.rule}}</td>
                  <td class="is-num">
                    {{#if this.passes}}
                    <span class="pf2e-gs-pill is-pass">YES</span>
                    {{else}}
                    <span class="pf2e-gs-pill is-miss">NO</span>
                    {{/if}}
                  </td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Hero Points (Own Dedicated Card) -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'hero-points')}}is-user-hidden{{/if}}"
          data-gs-card="hero-points"
          data-gs-keywords="hero point reroll fortune heroic recovery stabilize session award">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-star"></i> Hero Points</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
              <span class="pf2e-gs-subhint">Max 3 · Resets each session</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <ul class="pf2e-gs-bullets">
              {{#each heroPointRules}}
              <li data-gs-row="1"><strong>{{this.label}}:</strong> {{this.text}}</li>
              {{/each}}
            </ul>
          </div>
        </div>

        <!-- Key Flat Checks Cheat-Sheet -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'flat-checks')}}is-user-hidden{{/if}}"
          data-gs-card="flat-checks"
          data-gs-keywords="flat check dc 5 dc 11 dc 15 concealed hidden stupefied grabbed dying persistent recovery">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-dice-d20"></i> Key Flat Checks</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
              <span class="pf2e-gs-subhint">Unmodified d20 only (no bonuses)</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <table class="pf2e-gs-table">
              <tbody>
                {{#each flatCheckQuickRules}}
                <tr data-gs-row="1">
                  <td class="is-num is-dc">{{this.dc}}</td>
                  <td>{{this.when}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>

      </div>
    </section>

    <!-- =================================================================== -->
    <!-- TAB 2: COMBAT, STEALTH, INVISIBILITY, MOUNTED, FLYING & SWIMMING    -->
    <!-- =================================================================== -->
    <section class="pf2e-gs-stack" data-gs-panel="combat" style="display:none;">

      <!-- Common Combat Actions (Full-Width Table) -->
      <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'combat-actions')}}is-user-hidden{{/if}}"
        data-gs-card="combat-actions"
        data-gs-keywords="combat actions trip grapple shove disarm reposition demoralize feint diversion tumble escape aid persistent damage map">
        <div class="pf2e-gs-card-head">
          <h4><i class="fa-solid fa-swords"></i> Common Combat Actions (Remaster)</h4>
          <div class="pf2e-gs-card-head-right">
            <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            <span class="pf2e-gs-subhint">Actions with the Attack trait incur Multiple Attack Penalty (MAP)</span>
          </div>
        </div>
        <div class="pf2e-gs-card-body">
          <table class="pf2e-gs-table">
            <thead>
              <tr>
                <th>Action</th>
                <th class="is-num">Cost</th>
                <th>Check vs DC</th>
                <th>Outcomes</th>
              </tr>
            </thead>
            <tbody>
              {{#each combatActions}}
              <tr data-gs-row="1">
                <td><strong>{{this.name}}</strong></td>
                <td class="is-num"><span class="pf2e-gs-cost-badge">{{this.cost}}</span></td>
                <td>{{this.check}}</td>
                <td>{{this.summary}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Balanced 2-Column Masonry for All Combat & Tactical Niche Rules -->
      <div class="pf2e-gs-masonry">

        <!-- Cover -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'cover')}}is-user-hidden{{/if}}" data-gs-card="cover"
          data-gs-keywords="cover lesser standard greater take cover ac reflex stealth">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-shield-halved"></i> Cover</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <table class="pf2e-gs-table">
              <thead>
                <tr>
                  <th>Cover</th>
                  <th>Bonus</th>
                  <th>Notes</th>
                </tr>
              </thead>
              <tbody>
                {{#each coverRules}}
                <tr data-gs-row="1">
                  <td><strong>{{this.type}}</strong></td>
                  <td class="is-dc">{{this.bonus}}</td>
                  <td>{{this.notes}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Concealment & Detection States -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'detection')}}is-user-hidden{{/if}}"
          data-gs-card="detection"
          data-gs-keywords="detection concealed hidden undetected unnoticed observed flat check stealth seek">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-eye-slash"></i> Concealment &amp; Detection States</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <table class="pf2e-gs-table">
              <thead>
                <tr>
                  <th>State</th>
                  <th class="is-num">Flat DC</th>
                  <th>Effect</th>
                </tr>
              </thead>
              <tbody>
                {{#each detectionStates}}
                <tr data-gs-row="1">
                  <td><strong>{{this.state}}</strong></td>
                  <td class="is-num is-dc">{{this.flatDc}}</td>
                  <td>{{this.notes}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Stealth, Hide, Sneak, Seek & Point Out -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'stealth-sneaking')}}is-user-hidden{{/if}}"
          data-gs-card="stealth-sneaking"
          data-gs-keywords="stealth sneak sneaking hide seek point out perception cover concealment hidden undetected">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-user-ninja"></i> Stealth, Hide, Sneak &amp; Seek</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <ul class="pf2e-gs-bullets">
              {{#each stealthSneakingRules}}
              <li data-gs-row="1"><strong>{{this.label}}:</strong> {{this.text}}</li>
              {{/each}}
            </ul>
          </div>
        </div>

        <!-- Invisibility Rules -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'invisibility')}}is-user-hidden{{/if}}"
          data-gs-card="invisibility"
          data-gs-keywords="invisible invisibility unseen hidden undetected flat dc 11 seek sneak revealing light see the unseen">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-ghost"></i> Invisibility Rules</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <ul class="pf2e-gs-bullets">
              {{#each invisibilityRules}}
              <li data-gs-row="1"><strong>{{this.label}}:</strong> {{this.text}}</li>
              {{/each}}
            </ul>
          </div>
        </div>

        <!-- Dying, Wounded & Recovery -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'dying-recovery')}}is-user-hidden{{/if}}"
          data-gs-card="dying-recovery"
          data-gs-keywords="dying wounded doomed recovery check stabilize 0 hp death initiative">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-heart-pulse"></i> Dying, Wounded &amp; Recovery (Remaster)</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <ul class="pf2e-gs-bullets">
              {{#each dyingRecoveryRules}}
              <li data-gs-row="1"><strong>{{this.label}}:</strong> {{this.text}}</li>
              {{/each}}
            </ul>
          </div>
        </div>

        <!-- Falling, Terrain, Flanking & Suffocation -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'falling-terrain')}}is-user-hidden{{/if}}"
          data-gs-card="falling-terrain"
          data-gs-keywords="falling grab an edge water snow difficult terrain flanking breath hold suffocation drown">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-person-falling"></i> Falling, Terrain &amp; Suffocation</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <ul class="pf2e-gs-bullets">
              {{#each fallingTerrainRules}}
              <li data-gs-row="1"><strong>{{this.label}}:</strong> {{this.text}}</li>
              {{/each}}
            </ul>

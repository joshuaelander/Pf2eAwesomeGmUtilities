          data-gs-keywords="npc attitude helpful friendly indifferent unfriendly hostile make an impression request coerce lie diplomacy intimidation deception">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-comments"></i> NPC Attitudes &amp; Social Checks</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <ul class="pf2e-gs-bullets">
              {{#each socialAttitudeRules}}
              <li data-gs-row="1"><strong>{{this.label}}:</strong> {{this.text}}</li>
              {{/each}}
            </ul>
          </div>
        </div>

        <!-- Crafting, Identify Magic & Retraining -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'downtime-niche')}}is-user-hidden{{/if}}"
          data-gs-card="downtime-niche"
          data-gs-keywords="craft crafting formula identify magic retrain retraining subsist downtime">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-hammer"></i> Crafting, Identify Magic &amp; Retraining</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <ul class="pf2e-gs-bullets">
              {{#each downtimeNicheRules}}
              <li data-gs-row="1"><strong>{{this.label}}:</strong> {{this.text}}</li>
              {{/each}}
            </ul>
          </div>
        </div>

        <!-- Treat Wounds & Repair -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'treat-wounds')}}is-user-hidden{{/if}}"
          data-gs-card="treat-wounds"
          data-gs-keywords="treat wounds medicine healing dc 15 20 30 40 wounded battle medicine repair crafting">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-kit-medical"></i> Treat Wounds &amp; Repair</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
              <span class="pf2e-gs-subhint">10 min · 1 hr immunity · 1 hr = 2× HP</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <table class="pf2e-gs-table">
              <thead>
                <tr>
                  <th>Proficiency</th>
                  <th class="is-num">DC</th>
                  <th>Success</th>
                  <th>Crit Success</th>
                  <th>Crit Fail</th>
                </tr>
              </thead>
              <tbody>
                {{#each treatWoundsRows}}
                <tr data-gs-row="1">
                  <td><strong>{{this.rank}}</strong></td>
                  <td class="is-num is-dc">{{this.dc}}</td>
                  <td>{{this.success}}</td>
                  <td class="is-dc">{{this.critSuccess}}</td>
                  <td>{{this.critFail}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
            <div class="pf2e-gs-subhint" data-gs-row="1">
              <strong>Repair (Crafting, 10 min):</strong> Restores 5/10/15/20/25 HP (U/T/E/M/L); Crit Success restores
              10/20/30/40/50 HP. Crit Fail deals 2d6 dmg (minus Hardness).
            </div>
          </div>
        </div>

        <!-- Recall Knowledge -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'recall-knowledge')}}is-user-hidden{{/if}}"
          data-gs-card="recall-knowledge"
          data-gs-keywords="recall knowledge creature identification arcana nature occultism religion society lore rarity">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-brain"></i> Recall Knowledge (Remaster)</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
              <span class="pf2e-gs-subhint">Uncommon +2 · Rare +5 · Unique +10</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <table class="pf2e-gs-table">
              <thead>
                <tr>
                  <th>Skill</th>
                  <th>Creature Traits / Subjects</th>
                </tr>
              </thead>
              <tbody>
                {{#each recallKnowledgeSkills}}
                <tr data-gs-row="1">
                  <td><strong>{{this.skill}}</strong></td>
                  <td>{{this.creatures}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
            <div class="pf2e-gs-subhint" data-gs-row="1">
              <strong>Remaster:</strong> Player asks 1 specific question (weakest save, resistance, special ability).
              Crit Success gives 2 answers. Follow-up checks escalate (Hard +2 → Very Hard +5 → Incredibly Hard +10).
            </div>
          </div>
        </div>

        <!-- Spell Rank DCs & Learn a Spell -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'spell-rank-dcs')}}is-user-hidden{{/if}}"
          data-gs-card="spell-rank-dcs" data-gs-keywords="learn a spell identify magic spell rank dc cost gp">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-hat-wizard"></i> Spell Rank DCs &amp; Learn a Spell</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
              <span class="pf2e-gs-subhint">1 hr/rank · Crit = ½ cost</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <table class="pf2e-gs-table">
              <thead>
                <tr>
                  <th class="is-num">Rank</th>
                  <th class="is-num">DC</th>
                  <th class="is-num">Learn Cost</th>
                  <th class="is-num">Caster Lv</th>
                </tr>
              </thead>
              <tbody>
                {{#each spellRankRows}}
                <tr data-gs-row="1" class="{{#if this.isActive}}is-active-level{{/if}}">
                  <td class="is-num">Rank {{this.rank}}</td>
                  <td class="is-num is-dc">{{this.dc}}</td>
                  <td class="is-num">{{this.learnCost}}</td>
                  <td class="is-num">Lv {{this.minLevel}}+</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Rituals (Casting, DCs & Secondary Checks) -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'rituals-rules')}}is-user-hidden{{/if}}"
          data-gs-card="rituals-rules"
          data-gs-keywords="ritual rituals primary check secondary caster casters very hard dc cost heighten learn downtime fortune hero point">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-scroll"></i> Rituals (Casting &amp; Secondary Checks)</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
              <span class="pf2e-gs-subhint">Rank {{spellRank}} (Lv {{ritualBaseLevel}}): Sec DC {{ritualSecondaryDc}} · Pri DC {{ritualPrimaryDc}}</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <table class="pf2e-gs-table pf2e-gs-mini-table">
              <thead>
                <tr>
                  <th>Secondary Check</th>
                  <th>Effect on Primary Check</th>
                </tr>
              </thead>
              <tbody>
                {{#each ritualSecondaryOutcomes}}
                <tr data-gs-row="1">
                  <td><span class="pf2e-gs-pill {{this.cls}}">{{this.degree}}</span></td>
                  <td>{{this.effect}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
            <ul class="pf2e-gs-bullets">
              {{#each ritualRules}}
              <li data-gs-row="1"><strong>{{this.label}}:</strong> {{this.text}}</li>
              {{/each}}
            </ul>
          </div>
        </div>

      </div>

      <!-- Exploration Activities (Full-Width Table) -->
      <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'exploration-activities')}}is-user-hidden{{/if}}"
        data-gs-card="exploration-activities"
        data-gs-keywords="exploration activities avoid notice defend detect magic follow the expert hustle investigate repeat a spell scout search">
        <div class="pf2e-gs-card-head">
          <h4><i class="fa-solid fa-compass"></i> Exploration Activities</h4>
          <div class="pf2e-gs-card-head-right">
            <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
          </div>
        </div>
        <div class="pf2e-gs-card-body">
          <table class="pf2e-gs-table">
            <thead>
              <tr>
                <th>Activity</th>
                <th class="is-num">Speed</th>
                <th>Effect</th>
              </tr>
            </thead>
            <tbody>
              {{#each explorationActivities}}
              <tr data-gs-row="1">
                <td><strong>{{this.name}}</strong></td>
                <td class="is-num">{{this.speed}}</td>
                <td>{{this.summary}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- TAB 6: CONDITIONS CHEAT-SHEET (WITH LIVE PF2E COMPENDIUM LINKS)     -->
    <!-- =================================================================== -->
    <section class="pf2e-gs-stack" data-gs-panel="conditions" style="display:none;">
      <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'conditions-list')}}is-user-hidden{{/if}}"
        data-gs-card="conditions-list"
        data-gs-keywords="conditions status effects penalty flat-footed off-guard frightened sickened stunned slowed">
        <div class="pf2e-gs-card-head">
          <h4><i class="fa-solid fa-biohazard"></i> PF2e Remaster Conditions</h4>
          <div class="pf2e-gs-card-head-right">
            <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            <span class="pf2e-gs-subhint">Click any condition name to open its full official PF2e sheet</span>
          </div>
        </div>

        <div class="pf2e-gs-card-body">
          <div class="pf2e-gs-cond-grid">
            {{#each conditions}}
            <div class="pf2e-gs-cond-item" data-gs-row="1"
              data-gs-keywords="{{this.slug}} {{this.name}} {{#if this.valued}}valued{{/if}}">
              <div class="pf2e-gs-cond-head">
                <button type="button" class="pf2e-gs-cond-link" data-gs-action="open-condition"
                  data-slug="{{this.slug}}" data-name="{{this.name}}"
                  title="Open official PF2e Condition sheet for {{this.name}}">
                  {{this.name}}
                </button>
              </div>
              <div class="pf2e-gs-cond-desc">{{this.summary}}</div>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
    </section>

    <!-- =================================================================== -->
    <!-- TAB 7: ENCOUNTER BUILDER, TREASURE, TRAVEL, LIGHT & ENVIRONMENT     -->
    <!-- =================================================================== -->
    <section class="pf2e-gs-stack" data-gs-panel="encounters" style="display:none;">

      <!-- Interactive Encounter XP Builder (Full-Width) -->
      <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'encounter-builder')}}is-user-hidden{{/if}}"
        data-gs-card="encounter-builder"
        data-gs-keywords="encounter builder xp budget threat severity trivial low moderate severe extreme creature hazard">
        <div class="pf2e-gs-card-head">
          <h4><i class="fa-solid fa-dragon"></i> Quick Encounter XP Calculator (Party Lv {{focusLevel}})</h4>
          <div class="pf2e-gs-card-head-right">
            <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            <div class="pf2e-gs-stepper-group">
              <span>Party Size</span>
              <button type="button" class="pf2e-gs-btn pf2e-gs-btn-icon" data-gs-action="party-size-step"
                data-delta="-1"><i class="fa-solid fa-minus"></i></button>
              <span class="pf2e-gs-stepper-val">{{encounterEval.partySize}}</span>
              <button type="button" class="pf2e-gs-btn pf2e-gs-btn-icon" data-gs-action="party-size-step"
                data-delta="1"><i class="fa-solid fa-plus"></i></button>
            </div>
          </div>
        </div>

        <div class="pf2e-gs-card-body">
          <div class="pf2e-gs-enc-bar">
            <div class="pf2e-gs-enc-summary">
              <span class="pf2e-gs-enc-xp">{{encounterEval.totalXp}} XP</span>
              <span class="pf2e-gs-sev-badge {{encounterEval.severity.cls}}">{{encounterEval.severity.label}}</span>
              <span class="pf2e-gs-subhint">for {{encounterEval.partySize}} PC(s)</span>
            </div>
            {{#if hasEncounterEntries}}
            <button type="button" class="pf2e-gs-btn pf2e-gs-btn-xs" data-gs-action="enc-clear">
              <i class="fa-solid fa-trash"></i> Clear
            </button>
            {{/if}}
          </div>

          <div class="pf2e-gs-enc-chips">
            {{#each creatureXpRows}}
            <button type="button" class="pf2e-gs-chip" data-gs-action="enc-add" data-offset="{{this.offset}}"
              data-kind="creature" title="Add {{this.effectiveLevelLabel}} Creature ({{this.creatureXp}} XP)">
              + {{this.effectiveLevelLabel}} ({{this.creatureXp}})
            </button>
            {{/each}}
          </div>

          {{#if hasEncounterEntries}}
          <div class="pf2e-gs-enc-list">
            {{#each encounterEntries}}
            <span class="pf2e-gs-enc-tag">
              <span>{{this.label}} · <strong>{{this.xp}} XP</strong></span>
              <button type="button" data-gs-action="enc-remove" data-id="{{this.id}}" title="Remove">×</button>
            </span>
            {{/each}}
          </div>
          {{/if}}

          <div class="pf2e-gs-grid-2">
            <div class="pf2e-gs-stack">
              <table class="pf2e-gs-table">
                <thead>
                  <tr>
                    <th>Threat</th>
                    <th class="is-num">Budget ({{encounterEval.partySize}} PCs)</th>
                    <th class="is-num">Base (4 PCs)</th>
                    <th class="is-num">± Per PC</th>
                  </tr>
                </thead>
                <tbody>
                  {{#each encounterEval.budgets}}
                  <tr data-gs-row="1">
                    <td><span class="pf2e-gs-sev-badge {{this.cls}}">{{this.label}}</span></td>
                    <td class="is-num is-dc">{{this.adjustedXp}} XP</td>
                    <td class="is-num">{{this.baseXp}} XP</td>
                    <td class="is-num">±{{this.perPc}} XP</td>
                  </tr>
                  {{/each}}
                </tbody>
              </table>
              <div class="pf2e-gs-enc-guide">
                <div data-gs-row="1"><strong>Complex Hazard:</strong> Same XP as a Creature of its level.</div>
                <div data-gs-row="1"><strong>Simple Hazard:</strong> ⅕ Creature XP (click Simple Haz. column to add).
                </div>
                <div data-gs-row="1"><strong>XP Awarded:</strong> Always award the <em>4-PC Base</em> threat XP to each
                  PC (e.g. Moderate = 80 XP each), regardless of party size.</div>
              </div>
            </div>

            <table class="pf2e-gs-table">
              <thead>
                <tr>
                  <th>Relative Lv</th>
                  <th class="is-num">Lv</th>
                  <th class="is-num">Creature</th>
                  <th class="is-num">Simple Haz.</th>
                </tr>
              </thead>
              <tbody>
                {{#each creatureXpRows}}
                <tr data-gs-row="1">
                  <td>{{this.label}}</td>
                  <td class="is-num">{{this.effectiveLevelLabel}}</td>
                  <td class="is-num is-dc is-clickable-lvl" data-gs-action="enc-add" data-offset="{{this.offset}}"
                    data-kind="creature"
                    title="Click to add {{this.effectiveLevelLabel}} Creature ({{this.creatureXp}} XP)">
                    {{this.creatureXp}} XP</td>
                  <td class="is-num is-clickable-lvl" data-gs-action="enc-add" data-offset="{{this.offset}}"
                    data-kind="hazard"
                    title="Click to add {{this.effectiveLevelLabel}} Simple Hazard ({{this.simpleHazardXp}} XP)">
                    {{this.simpleHazardXp}} XP</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <!-- Party Treasure by Level (Full-Width) -->
      <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'treasure-by-level')}}is-user-hidden{{/if}}"
        data-gs-card="treasure-by-level"
        data-gs-keywords="treasure loot wealth gold gp permanent consumables party by level">
        <div class="pf2e-gs-card-head">
          <h4><i class="fa-solid fa-gem"></i> Party Treasure by Level (4 PCs, Remaster)</h4>
          <div class="pf2e-gs-card-head-right">
            <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            <span class="pf2e-gs-subhint">Highlighting Lv {{focusLevel}}</span>
          </div>
        </div>
        <div class="pf2e-gs-card-body">
          <table class="pf2e-gs-table">
            <thead>
              <tr>
                <th class="is-num">Lv</th>
                <th class="is-num">Total</th>
                <th>Permanent Items</th>
                <th>Consumables</th>
                <th class="is-num">Currency</th>
                <th>+1 Extra PC</th>
              </tr>
            </thead>
            <tbody>
              {{#each treasureRows}}
              <tr data-gs-row="1"
                class="{{#if this.isActive}}is-active-level{{else}}{{#if this.isNearby}}is-nearby-level{{/if}}{{/if}}">
                <td class="is-num is-clickable-lvl" data-gs-action="set-level" data-level="{{this.level}}">
                  {{this.level}}</td>
                <td class="is-num is-dc">{{this.total}}</td>
                <td>{{this.permanent}}</td>
                <td>{{this.consumables}}</td>
                <td class="is-num">{{this.currency}}</td>
                <td>{{this.perExtraPc}}</td>
              </tr>
              {{/each}}
            </tbody>
          </table>
        </div>
      </div>

      <!-- Balanced 2-Column Masonry for Travel, Accomplishment XP, Light/Vision & Environment -->
      <div class="pf2e-gs-masonry">

        <!-- Overland Travel Speed -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'travel-speed')}}is-user-hidden{{/if}}"
          data-gs-card="travel-speed" data-gs-keywords="travel speed miles per hour day overland movement">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-route"></i> Overland Travel Speed</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
              <span class="pf2e-gs-subhint">8 hrs/day (½ difficult terrain)</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <table class="pf2e-gs-table">
              <thead>
                <tr>
                  <th>Speed</th>
                  <th class="is-num">Per Min</th>
                  <th class="is-num">Per Hour</th>
                  <th class="is-num">Per Day (8h)</th>
                </tr>
              </thead>
              <tbody>
                {{#each travelSpeedRows}}
                <tr data-gs-row="1">
                  <td><strong>{{this.speed}}</strong></td>
                  <td class="is-num">{{this.perMin}}</td>
                  <td class="is-num">{{this.perHour}}</td>
                  <td class="is-num is-dc">{{this.perDay}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Light, Vision & Senses -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'light-vision')}}is-user-hidden{{/if}}"
          data-gs-card="light-vision"
          data-gs-keywords="light dim darkness vision darkvision low-light torch lantern senses precise imprecise vague tremorsense">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-lightbulb"></i> Light, Vision &amp; Senses</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <ul class="pf2e-gs-bullets">
              {{#each lightVisionRules}}
              <li data-gs-row="1"><strong>{{this.label}}:</strong> {{this.text}}</li>
              {{/each}}
            </ul>
          </div>
        </div>

        <!-- Accomplishment XP Awards -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'accomplishment-xp')}}is-user-hidden{{/if}}"
          data-gs-card="accomplishment-xp"
          data-gs-keywords="accomplishment xp award minor moderate major story milestone">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-award"></i> Accomplishment XP Awards</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <table class="pf2e-gs-table">
              <thead>
                <tr>
                  <th>Type</th>
                  <th class="is-num">XP</th>
                  <th>Examples</th>
                </tr>
              </thead>
              <tbody>
                {{#each accomplishmentXp}}
                <tr data-gs-row="1">
                  <td><strong>{{this.type}}</strong></td>
                  <td class="is-num is-dc">{{this.xp}}</td>
                  <td>{{this.note}}</td>
                </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        </div>

        <!-- Object Hardness, Doors & Environment -->
        <div class="pf2e-gs-card {{#if (lookup hiddenCardMap 'objects-environment')}}is-user-hidden{{/if}}"
          data-gs-card="objects-environment"
          data-gs-keywords="hardness hp broken threshold door force open wood stone iron temperature cold heat bulk encumbrance">
          <div class="pf2e-gs-card-head">
            <h4><i class="fa-solid fa-door-closed"></i> Object Hardness, Doors &amp; Environment</h4>
            <div class="pf2e-gs-card-head-right">
              <span class="pf2e-gs-hidden-tag">Hidden in Customize</span>
            </div>
          </div>
          <div class="pf2e-gs-card-body">
            <ul class="pf2e-gs-bullets">
              {{#each objectsEnvironmentRules}}
              <li data-gs-row="1"><strong>{{this.label}}:</strong> {{this.text}}</li>
              {{/each}}
            </ul>
          </div>
        </div>

      </div>
    </section>

    <div class="pf2e-gs-empty-tab">
      <i class="fa-solid fa-eye-slash"></i>
      <span>All sections on this tab are currently hidden. Click <strong>Customize</strong> above to show them
        again.</span>
    </div>

    <div class="pf2e-gs-empty-search">
      <i class="fa-solid fa-magnifying-glass"></i> No matching GM Screen tables or rules found. Try a shorter keyword or
      clear the filter.
    </div>

  </div>
</div>